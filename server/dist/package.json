{
  "name": "@nx-chat-assignment/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "nx run-many --target=serve --projects=server,client",
    "start:server": "nx run server:serve",
    "start:client": "nx run client:serve",
    "test": "nx run-many --target=test",
    "test:server": "nx run server:test",
    "test:client": "nx run client:test",
    "lint": "nx run-many --target=lint --all",
    "lint:server": "nx run server:lint",
    "lint:client": "nx run client:lint",
    "format": "nx format --all"
  },
  "private": true,
  "workspaces": [
    "packages/*",
    "shared-models",
    "server",
    "client"
  ],
  "dependencies": {
    "express": "^4.21.2",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "main": "main.js"
}